{
  "name": "kane-loop",
  "version": "0.1.0",
  "description": "Agent-agnostic verification loop around Kane CLI: git diff -> affected _test.md flows -> headless replay -> .kane/last-failure.md -> MCP tools for coding agents.",
  "type": "module",
  "bin": { "kane-loop": "bin/kane-loop.js" },
  "scripts": {
    "app": "node demo-app/server.js",
    "verify": "node bin/kane-loop.js verify",
    "verify:all": "node bin/kane-loop.js verify --all",
    "watch": "node bin/kane-loop.js watch",
    "mcp": "node bin/kane-loop.js mcp",
    "test": "node --test test/*.test.js"
  },
  "engines": { "node": ">=18.17" },
  "keywords": ["kane-cli", "testmu", "e2e", "mcp", "agents", "testing"],
  "author": "Aleksandr Kulikov",
  "license": "MIT"
}
